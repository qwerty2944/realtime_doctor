# Get a Google AI Studio key at https://aistudio.google.com/apikey
# DO NOT commit this file with a real key. Copy it to .env (which is gitignored).
GEMINI_API_KEY=AIza-REPLACE_ME

# Optional model overrides — Gemini 2.5 flash is multimodal (audio in) + cheap.
# For higher quality narrative output, switch summarizer/dictator to gemini-2.5-pro.
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_DIARIZER_MODEL=gemini-2.5-flash
GEMINI_ANALYZER_MODEL=gemini-2.5-flash
GEMINI_SUMMARIZER_MODEL=gemini-2.5-flash
GEMINI_DICTATOR_MODEL=gemini-2.5-flash

# OpenAI는 선택 사항 — 채워 두면 설정 창에서 전사 공급자로 OpenAI 선택 가능.
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# CLOVA CSR (Application Key) — NCP API Gateway 단문 인식
# CLOVA_API_KEY_ID=
# CLOVA_API_KEY=

# CLOVA Speech 장문 인식 도메인 Secret — gRPC bidi 스트리밍
# NCP 콘솔 → AI·Application Service → CLOVA Speech → 도메인 → 인증 정보
# CLOVA_SPEECH_SECRET=

# Supabase Auth + 진료 데이터 클라우드 동기화 (선택, 둘 다 채워야 활성)
# 대시보드 → Project Settings → API Keys 에서 publishable 키 복사.
# 대시보드 → Authentication → Providers → Email → "Confirm email" 토글 OFF 필요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
