# Get a Google AI Studio key at https://aistudio.google.com/apikey
# DO NOT commit this file with a real key. Copy it to .env (which is gitignored).
GEMINI_API_KEY=AIza-REPLACE_ME

# Optional model overrides — Gemini 3.5 flash-lite is multimodal (audio in), low-latency + cheap.
# For higher quality narrative output, switch summarizer/dictator to a pro model.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_DIARIZER_MODEL=gemini-3.5-flash-lite
GEMINI_ANALYZER_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARIZER_MODEL=gemini-3.5-flash-lite
GEMINI_DICTATOR_MODEL=gemini-3.5-flash-lite

# [HARD] 이 다섯 값은 ai-gemini Edge Function 의 GEMINI_ALLOWED_MODELS 시크릿과
# 일치해야 한다. 어긋나면 프록시가 400 model_not_allowed 로 거절한다.

# OpenAI는 선택 사항 — 채워 두면 설정 창에서 전사 공급자로 OpenAI 선택 가능.
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# CLOVA CSR (Application Key) — NCP API Gateway 단문 인식
# CLOVA_API_KEY_ID=
# CLOVA_API_KEY=

# CLOVA Speech 장문 인식 도메인 Secret — gRPC bidi 스트리밍
# NCP 콘솔 → AI·Application Service → CLOVA Speech → 도메인 → 인증 정보
# CLOVA_SPEECH_SECRET=

# Supabase Auth + 진료 데이터 클라우드 동기화 (선택, 둘 다 채워야 활성)
# 대시보드 → Project Settings → API Keys 에서 publishable 키 복사.
# 대시보드 → Authentication → Providers → Email → "Confirm email" 토글 OFF 필요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ── 구독 게이트 (S2) ────────────────────────────────────────────────────────
# 아래 값들은 앱 번들에 인라인된다. 전부 공개 정보여야 한다.
#
# [HARD] ENTITLEMENT_PRIVATE_KEY 는 여기에 넣지 않는다. 개인키는 Supabase Edge
# Function 의 환경변수(supabase/functions/.env 또는 `supabase secrets set`)에만
# 둔다. 앱이 개인키를 가지면 스스로 "구독 중" 토큰을 찍어낼 수 있어 게이트가
# 무의미해진다.
#
# 검증 전용 공개키 (SPKI DER base64). 비우면 코드의 기본값을 쓴다.
# ENTITLEMENT_PUBLIC_KEY=
# entitlement Edge Function 주소. 비우면 ${SUPABASE_URL}/functions/v1/entitlement.
# ENTITLEMENT_URL=http://127.0.0.1:55321/functions/v1/entitlement
# admin-web 결제 페이지. 비우면 src/main/subscription.ts 의 기본값(같은 주소)이
# 쓰인다. [HARD] `/righthand` 접두사 필수 -- admin-web 은 basePath 를 달고
# entanglecare.com 아래에 재작성으로 얹혀 있다(doctor-web/next.config.ts).
# BILLING_PORTAL_URL=https://entanglecare.com/righthand/billing
