# Vercel 대시보드 또는 로컬 dev용 .env.local에 채워넣을 변수.

# --- Supabase ---------------------------------------------------------------
# 기존 어드민 화면은 anon key 만으로 동작한다.
NEXT_PUBLIC_SUPABASE_URL=https://yqdzxitlmtawznzwpkra.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# 구독/결제 라우트 전용. subscriptions 테이블은 0002 설계상 service_role 만
# 쓸 수 있다. [HARD] 서버 전용 — NEXT_PUBLIC_ 을 붙이지 말 것.
# 위치: Supabase 대시보드 > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# --- 포트원 (PortOne V2) ------------------------------------------------------
# [선택] 이 네 개(STORE_ID / CHANNEL_KEY / API_SECRET / WEBHOOK_SECRET)가 없어도
# 서버는 뜬다. 대신 결제 기능만 꺼진다: /billing 이 "준비 중"을 표시하고,
# /api/billing/* 는 503 을 주고, /api/health 가 degraded 로 떨어져 ops 프로버에
# 잡힌다. 자리표시자 값을 넣지 말 것 -- 넣으면 결제창이 열리고 PG 가 거절해서
# "설정 누락"이 "카드 거절"로 위장된다.
# PG 는 나이스페이 또는 스마트로 중 무엇이든 된다. 코드에는 PG 종속 분기가 없고
# 채널키 하나로 결정된다.
#
# 콘솔에서 가져올 값 (admin.portone.io):
#   1) 상점 ID       : 결제연동 > 연동 정보 > 식별코드·API Keys 의 "Store ID"
#                      (`store-` 로 시작). 브라우저에 노출되는 공개 값이다.
#   2) 채널 키       : 결제연동 > 연동 정보 > 채널 관리에서 사용할 PG 채널을
#                      만든 뒤 그 채널의 "채널 키" (`channel-key-` 로 시작).
#                      테스트 채널과 실결제 채널이 다르다.
#   3) API Secret    : 결제연동 > 연동 정보 > 식별코드·API Keys 의 "V2 API Secret".
#                      [HARD] 서버 전용. 이 값이면 임의 결제·해지가 가능하다.
NEXT_PUBLIC_PORTONE_STORE_ID=store-REPLACE_ME
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-REPLACE_ME
PORTONE_API_SECRET=REPLACE_ME
# 포트원 REST 기본 주소. 비워두면 https://api.portone.io.
# 테스트에서 목 서버로 갈아끼울 때만 설정한다.
# PORTONE_API_BASE=http://127.0.0.1:5599

# --- Electron 자동 로그인 핸드오프 ---------------------------------------------
# 앱에서 "구독하기"를 누르면 1회용 링크로 브라우저에 로그인시킨다.
# 이 비밀키는 그 링크 봉투(HMAC)에 쓰인다. 아무 32바이트 랜덤이면 된다:
#   openssl rand -base64 32
BILLING_HANDOFF_SECRET=REPLACE_ME
# 링크에 박히는 자기 주소. Vercel 에서는 생략 가능(VERCEL_URL 사용).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- S4: 웹훅 + 예약 누락 감시 -------------------------------------------------
# 포트원 웹훅 서명 검증용 시크릿.
# 위치: admin.portone.io > 결제연동 > 연동 정보 > 웹훅 관리에서 웹훅을 등록하면
#       발급된다 (`whsec_` 로 시작하는 base64). 엔드포인트 주소는
#       https://<admin-web 도메인>/api/billing/webhook 로 등록한다.
#       구독할 이벤트: Transaction.Paid, Transaction.Failed, BillingKey.Deleted.
#
# [HARD] 서버 전용. 이 값이 없거나 검증을 건너뛰면 누구나 JSON 하나를 POST 해서
# 아무 구독이나 활성화할 수 있다 -- 유료화 전체의 인증 우회다.
PORTONE_WEBHOOK_SECRET=whsec_REPLACE_ME

# 예약 누락 감시 크론(/api/billing/watchdog)을 부를 때 쓰는 Bearer 토큰.
# 아무 32바이트 랜덤이면 된다:  openssl rand -base64 32
#
# [HARD] 이름은 반드시 CRON_SECRET 이어야 한다. Vercel Cron 은 **정확히 이
# 이름**의 환경변수가 있을 때만 스케줄 호출에 Authorization: Bearer 를 붙인다.
# 다른 이름을 쓰면 크론이 매 실행 401 을 받고, watchdog 은 실행 기록을 인증
# 뒤에 쓰므로 subscription_watchdog_runs 가 비어 있는 채로 남는다 -- 증상이
# "아무 일도 안 일어남"이라 감시가 잡으려는 조용한 과금 중단과 구분되지 않는다.
# 되돌림은 admin-web/scripts/assert-cron-secret-name.mjs 가 빌드에서 막는다.
# 스케줄은 admin-web/vercel.json 에 있다 (매일 UTC 18:00 = KST 03:00).
CRON_SECRET=REPLACE_ME

# --- 배포 위치 ----------------------------------------------------------------
# 이 앱은 entanglecare.com/righthand/billing 로 재작성되어 서비스된다. 그래서
# 페이지·API·정적 자산이 전부 이 접두사 아래에 있어야 한다 (doctor-web 의
# next.config.ts 주석 참조). 로컬에서 접두사 없이 띄우려면 비워 두면 된다.
NEXT_PUBLIC_BASE_PATH=/righthand
