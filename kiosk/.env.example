# realtime_doctor 문진 키오스크 — 환경변수
#
# 이 파일을 kiosk/.env.local 로 복사해서 값을 채우세요.
# .env* 는 gitignore 되어 있습니다 (.env.example 만 예외).
#
# 아래 "필수" 항목이 하나라도 비어 있으면 서버가 부팅 시점에 그 이름을 대고
# 죽습니다 (instrumentation.ts → lib/env.ts). 요청 중간에 조용히 실패하지 않습니다.

# ─── 필수 ────────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL. realtime_doctor 루트 .env 의 SUPABASE_URL 과 같은 값.
SUPABASE_URL=

# 서비스 롤 키. **서버 전용이며 절대 브라우저에 노출되면 안 됩니다.**
# 환자는 로그인하지 않으므로 anon 롤에는 적용될 RLS 정책이 없고, 문진의 모든
# 쓰기는 이 키로만 나갑니다.
# Supabase 대시보드 → Project Settings → API → service_role.
# 주의: 루트 .env 의 SUPABASE_PUBLISHABLE_KEY 는 이것이 아닙니다.
# 이름에 NEXT_PUBLIC_ 을 절대 붙이지 마세요 — 붙는 순간 번들에 인라인됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 문진 세션 토큰 서명용 HMAC 비밀키. 32바이트 이상 무작위 문자열.
#   생성 예: openssl rand -hex 32
# 이 값을 바꾸면 진행 중이던 문진 토큰이 전부 무효가 됩니다(끝난 문진은 무관).
KIOSK_TOKEN_SECRET=

# 키오스크 슬러그 → 담당 의사 auth user id (JSON).
# 이것이 "이 문진은 누구 것인가" 를 결정합니다. encounters.user_id 가 여기서
# 나오고, RLS 가 user_id = auth.uid() 이므로 값이 틀리면 그 환자는 어떤
# 의사에게도 보이지 않습니다. 자세한 설명은 README 와 lib/intake/kiosk.ts.
#   uuid 확인: Supabase 대시보드 → Authentication → Users → 해당 의사의 UID
#   태블릿 URL:  https://<배포주소>/intake?k=main
# 슬러그가 하나뿐이면 ?k= 를 생략해도 됩니다.
KIOSK_CLINICIANS={"main":"00000000-0000-0000-0000-000000000000"}

# Gemini API 키. 문진 질문 생성과 결과 초안 작성에 씁니다.
# 루트 .env 의 GEMINI_API_KEY 와 같은 값을 쓸 수 있습니다.
# (GOOGLE_API_KEY 도 대체로 인식하지만, 배포에서는 이 이름을 권장합니다.)
GEMINI_API_KEY=

# ─── 선택 ────────────────────────────────────────────────────────────────

# 배포 하위 경로 (basePath).
#
# 키오스크는 도메인 루트가 아니라 `<도메인>/righthand/patient` 에서 서비스됩니다.
# **경로 조각만** 넣으세요 — 호스트명은 넣지 않습니다(도메인은 아직 구매 전이고,
# 코드 어디에도 도메인을 박지 않습니다).
#
# 비워두면 루트 배포로 동작합니다. 로컬 개발은 비워두세요.
#   예: NEXT_PUBLIC_BASE_PATH=/righthand/patient
#
# 이 앱에서 브라우저로 나가는 유일한 환경변수이며, 담고 있는 것은 공개 URL 의
# 경로 조각입니다(비밀이 아닙니다). 다른 변수에는 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
# NEXT_PUBLIC_BASE_PATH=

# Gemini 엔드포인트. 기본값은 Google 이고, 사내 프록시나 게이트웨이를 쓸 때만
# 바꿉니다. 운영 배포에서는 설정하지 마세요.
# (프로브가 "거절된 접근은 모델을 부르지 않는다" 를 세기 위해 쓰는 이음매이기도 합니다.)
# GEMINI_API_BASE=

# LLM 프로바이더. 현재 지원값은 gemini 하나이고 기본값도 gemini 입니다.
# 환자 동의서가 처리자 이름을 이 값에서 가져옵니다.
# LLM_PROVIDER=gemini

# Gemini 모델 id. 미설정 시 gemini-3.5-flash.
# 강제 도구 호출(functionCallingConfig mode=ANY)을 지키는 모델이어야 합니다.
# GEMINI_MODEL=gemini-3.5-flash

# CLOVA Speech — 음성 입력용. 둘 다 설정해야 녹음 버튼이 나타납니다.
# 없으면 문진은 글자 입력만으로 정상 동작합니다.
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET=
