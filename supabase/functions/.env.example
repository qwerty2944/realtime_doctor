# entitlement Edge Function 이 요구하는 비밀값.
#
# ECDSA P-256 개인키 (PKCS#8 DER 을 base64). 아래로 새로 만든다:
#   node -e "const{generateKeyPairSync}=require(\"crypto\");const{publicKey,privateKey}=generateKeyPairSync(\"ec\",{namedCurve:\"P-256\"});console.log(\"PRIV=\"+privateKey.export({type:\"pkcs8\",format:\"der\"}).toString(\"base64\"));console.log(\"PUB=\"+publicKey.export({type:\"spki\",format:\"der\"}).toString(\"base64\"))"
#
# PRIV 는 여기(또는 `supabase secrets set`)에만, PUB 은 앱의
# ENTITLEMENT_PUBLIC_KEY 에 넣는다. 절대 반대로 하지 말 것.
ENTITLEMENT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# A1: provider 키. 여기(또는 `supabase secrets set`)에만 둔다.
# ---------------------------------------------------------------------------
# [HARD] 이 두 개를 루트 `.env` 에 넣지 말 것. 루트 .env 는
# electron.vite.config.ts 가 읽어 main 번들에 평문으로 인라인하는 파일이고,
# 넣는 순간 A1 이 되돌려진다 (scripts/ci-assert-embedded.mjs 가 빌드를 실패시킨다).
GEMINI_API_KEY=
OPENAI_API_KEY=

# 선택. 앱이 지목할 수 있는 모델을 더 좁힌다 (쉼표 구분).
# 비우면 `gemini-*` 패턴 전체가 허용된다.
GEMINI_ALLOWED_MODELS=

# 선택. OpenAI Realtime 전사 모델. 기본값 gpt-4o-transcribe.
# [A1] 앱이 아니라 서버가 모델을 정한다 -- 앱이 고를 수 있으면 비용 상한이 없다.
OPENAI_TRANSCRIBE_MODEL=

# 검증 전용. provider 호출 횟수를 세려고 프로브가 가짜 업스트림으로 돌린다.
# 운영에서는 비워 둔다. (scripts/probe-ai-proxy.mjs)
GEMINI_UPSTREAM_BASE=
OPENAI_UPSTREAM_BASE=
